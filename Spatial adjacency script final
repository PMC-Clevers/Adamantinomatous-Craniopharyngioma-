    dplyr::mutate(target = factor(target, levels = levels(plot_summary$target)))
  src_stage <- ifelse(is.na(stage_map[src]), "Other", stage_map[src])
  p <- ggplot() +
    geom_col(data = plot_summary,
             aes(x = target, y = median_zscore, fill = target_stage),
             alpha = 0.6, width = 0.75) +
    geom_hline(yintercept = 0, linetype = "dashed",
               colour = "grey30", linewidth = 0.8) +
    geom_point(data = plot_patients,
               aes(x = target, y = zscore, colour = patient),
               size = 3, alpha = 0.9,
               position = position_jitter(width = 0.15, seed = 42)) +
    scale_fill_manual(values = stage_colours, name = "Stage", drop = FALSE) +
    scale_colour_brewer(palette = "Set1", name = "Patient") +
    pub_theme() +
    ylab("Neighborhood enrichment z-score") + xlab("") +
    labs(title    = paste0(src, "  [", src_stage, " stage]"),
         subtitle = paste0("Bars = median | dots = individual patients | ",
                           "k=", K_NHOOD, " | n = ",
                           dplyr::n_distinct(plot_patients$patient),
