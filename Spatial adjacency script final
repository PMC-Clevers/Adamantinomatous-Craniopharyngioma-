################################################################################
## spatial_adjacency.R
## Squidpy-equivalent spatial neighborhood-enrichment analysis (in R) for ACP Xenium.
##
## Neighborhood enrichment z-scores from an undirected, symmetrised kNN graph
## (k = 6) with 1,000 label permutations:
##     z = (observed - mean(permuted)) / SD(permuted)
## computed within each ROI (no edges across tissue pieces).
##
## Analyses:
##   1. Developmental cell-type pairs: adjacent vs non-adjacent controls.
##   2. Developmental stages: sequential vs stage-skipping transitions.
##   3. Unbiased landscape: full z-score heatmap across all populations.
##   4. Immune compartment: each immune subtype vs the oral and dental fractions.
##
## Cohort-level enrichment tested per cell-type pair with a one-sample Wilcoxon
## test and Benjamini-Hochberg correction.
################################################################################

library(Seurat)
library(FNN)
library(purrr)
library(dplyr)
library(ggplot2)
library(pheatmap)
library(RColorBrewer)

set.seed(1)
K       <- 6
N_PERM  <- 1000
MIN_CELLS <- 20

xenium <- readRDS("xenium_with_immune_subtypes.rds")   # carries annotation_immune

## ----------------------------------------------------------------------------
## patient -> ROIs (15 ROIs across 5 patients). CONFIRM against names(xenium@images)
## ----------------------------------------------------------------------------
patient_map <- list(
  ACP004 = c("ROI_BT288_1", "ROI_20251030_newregions_bt288_coordinates"),
  ACP005 = c("ROI_TMA1","ROI_TMA2","ROI_TMA3"),
  ACP006 = c("ROI_TMA8","ROI_TMA9","ROI_TMA10"),
  ACP007 = c("ROI_TMA11","ROI_TMA12","ROI_TMA13","ROI_TMA14"),
  ACP008 = c("ROI_TMA4","ROI_TMA6","ROI_TMA7")
)

## ----------------------------------------------------------------------------
## Per-ROI cell table: coordinates + annotation (annotation_immune)
## ----------------------------------------------------------------------------
build_df <- function(roi, annot_col = "annotation_immune") {
  coords <- GetTissueCoordinates(xenium[[roi]])            # x, y, cell
  cells  <- coords$cell
  cells  <- intersect(cells, colnames(xenium))
  coords <- coords[match(cells, coords$cell), ]
  data.frame(x = coords$x, y = coords$y,
             label = xenium@meta.data[cells, annot_col],
             row.names = cells, stringsAsFactors = FALSE) %>%
    filter(!is.na(label))
}

## ----------------------------------------------------------------------------
## Squidpy-equivalent neighborhood enrichment for one ROI.
## Returns a z-score matrix (label x label) over the undirected kNN graph.
## ----------------------------------------------------------------------------
run_nhood_enrichment_squidpy <- function(df, k = K, n_perm = N_PERM) {
  labs <- factor(df$label)
  lv   <- levels(labs)
  n    <- nrow(df)
  if (n <= k) return(NULL)

  ## undirected symmetrised kNN edge list
  knn <- FNN::get.knn(as.matrix(df[, c("x","y")]), k = k)$nn.index
  ei  <- rep(seq_len(n), each = k); ej <- as.vector(t(knn))
  keep <- ei < ej                      # de-duplicate; symmetric graph
  a <- ei[keep]; b <- ej[keep]
  ## also add the reverse duplicates that were on the other side
  und <- unique(rbind(cbind(pmin(ei,ej), pmax(ei,ej))))
  a <- und[,1]; b <- und[,2]

  count_edges <- function(l) {
    la <- l[a]; lb <- l[b]
    m <- matrix(0, length(lv), length(lv), dimnames = list(lv, lv))
    tab <- table(factor(la, lv), factor(lb, lv))
    m <- tab + t(tab)                  # undirected
    diag(m) <- diag(tab)
    m
  }
  obs <- count_edges(as.integer(labs))
  ## permutation null
  perm <- array(0, c(length(lv), length(lv), n_perm))
  for (p in seq_len(n_perm)) perm[,,p] <- count_edges(sample(as.integer(labs)))
  mu <- apply(perm, c(1,2), mean); sdv <- apply(perm, c(1,2), sd)
  z  <- (obs - mu) / sdv
  z[!is.finite(z)] <- NA
  dimnames(z) <- list(lv, lv)
  z
}

## Extract a directed pair's z-score from an ROI's z matrix
pair_z <- function(zmat, A, B) if (is.null(zmat) || !(A %in% rownames(zmat)) || !(B %in% colnames(zmat))) NA else zmat[A, B]

## Compute z matrices for all ROIs once (reused by all analyses)
z_by_roi <- purrr::map(unlist(patient_map), function(roi) {
  if (!roi %in% names(xenium@images)) return(NULL)
  run_nhood_enrichment_squidpy(build_df(roi))
})
names(z_by_roi) <- unlist(patient_map)

## helper: per-patient median z for a set of ROIs and a pair
patient_pair_z <- function(A, B) {
  purrr::imap_dfr(patient_map, function(rois, pt) {
    zs <- purrr::map_dbl(rois, ~ pair_z(z_by_roi[[.x]], A, B))
    data.frame(patient = pt, z = median(zs, na.rm = TRUE))
  })
}

################################################################################
## 1. Developmental cell-type pairs: adjacent vs non-adjacent controls
################################################################################

adjacent_pairs <- list(
  c("Oral epithelium","Transitioning"), c("Transitioning","Dental Epithelium"),
  c("Dental Epithelium","OEE/SI"), c("OEE/SI","SI / SR"),
  c("SI / SR","Cluster Cells"), c("Pre-ameloblast","Ameloblast"),
  c("Ameloblast","Junctional Keratinocytes"), c("Junctional basal","Junctional Keratinocytes"),
  c("Sulcus basal","Junctional Keratinocytes")
)
control_pairs <- list(   # non-adjacent, stage-skipping
  c("Oral epithelium","SI / SR"), c("Oral epithelium","Ameloblast"),
  c("Dental Epithelium","Ameloblast"), c("Transitioning","Ameloblast")
)
build_pair_df <- function(pairs, type) purrr::map_dfr(pairs, function(p) {
  patient_pair_z(p[1], p[2]) %>% mutate(pair = paste(p[1],"->",p[2]), type = type)
})
dev_df <- bind_rows(build_pair_df(adjacent_pairs, "Adjacent"),
                    build_pair_df(control_pairs, "Non-adjacent control"))

ggplot(dev_df, aes(pair, z, fill = type)) +
  geom_violin(scale = "width") + geom_jitter(width = 0.1, size = 1) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  scale_fill_manual(values = c("Adjacent" = "#6BAED6", "Non-adjacent control" = "#FB6A4A")) +
  theme_classic() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  labs(y = "Neighbourhood enrichment z-score", x = NULL,
       title = "Developmental pair spatial enrichment (Squidpy-equivalent)")
ggsave("plot1_developmental_pairs_violin.pdf", width = 11, height = 5)

################################################################################
## 2. Developmental stages: sequential vs stage-skipping transitions
################################################################################

# CONFIRM stage_map: assign each population to bud/cap/bell/eruption
stage_map <- c(
  "Oral epithelium" = "Bud", "Transitioning" = "Bud",
  "Dental Epithelium" = "Cap", "OEE/SI" = "Cap", "SI / SR" = "Cap",
  "Pre-ameloblast" = "Bell", "Ameloblast" = "Bell", "Cluster Cells" = "Bell",
  "Junctional Keratinocytes" = "Eruption", "Junctional basal" = "Eruption",
  "Sulcus Keratinocytes" = "Eruption", "Sulcus basal" = "Eruption", "PDL" = "Eruption"
)
stage_pair_z <- function(sA, sB) {
  A <- names(stage_map)[stage_map == sA]; B <- names(stage_map)[stage_map == sB]
  purrr::imap_dfr(patient_map, function(rois, pt) {
    zs <- unlist(purrr::map(rois, function(r)
      as.vector(outer(A, B, Vectorize(function(a,b) pair_z(z_by_roi[[r]], a, b))))))
    data.frame(patient = pt, z = median(zs, na.rm = TRUE))
  })
}
seq_trans  <- list(c("Bud","Cap"), c("Cap","Bell"), c("Bell","Eruption"))
skip_trans <- list(c("Bud","Bell"), c("Cap","Eruption"), c("Bud","Eruption"))
stage_df <- bind_rows(
  purrr::map_dfr(seq_trans,  ~ stage_pair_z(.x[1], .x[2]) %>% mutate(trans = paste(.x[1],"->",.x[2]), type = "sequential")),
  purrr::map_dfr(skip_trans, ~ stage_pair_z(.x[1], .x[2]) %>% mutate(trans = paste(.x[1],"->",.x[2]), type = "skip"))
)
ggplot(stage_df, aes(trans, z, fill = type)) +
  geom_violin(scale = "width") + geom_jitter(width = 0.1) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  scale_fill_manual(values = c("sequential" = "#74C476", "skip" = "#FB6A4A")) +
  theme_classic() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  labs(y = "Neighbourhood enrichment z-score", x = NULL,
       title = "Developmental stage spatial enrichment (Squidpy-equivalent)")
ggsave("plot2_developmental_stages_violin.pdf", width = 8, height = 5)

################################################################################
## 3. Unbiased landscape: mean z-score heatmap across all populations
################################################################################

all_labs <- sort(unique(unlist(lapply(z_by_roi, rownames))))
Zsum <- array(NA, c(length(all_labs), length(all_labs), length(z_by_roi)),
              dimnames = list(all_labs, all_labs, names(z_by_roi)))
for (r in names(z_by_roi)) {
  z <- z_by_roi[[r]]; if (is.null(z)) next
  Zsum[rownames(z), colnames(z), r] <- z
}
Zmean <- apply(Zsum, c(1,2), mean, na.rm = TRUE)
Zmean[!is.finite(Zmean)] <- 0
cap <- 9.4; Zmean[Zmean >  cap] <-  cap; Zmean[Zmean < -cap] <- -cap
pheatmap(Zmean, color = colorRampPalette(rev(brewer.pal(11, "PuOr")))(100),
         main = "Spatial neighbourhood enrichment z-score",
         filename = "plot3_zscore_heatmap.pdf", width = 11, height = 10)

################################################################################
## 4. Immune compartment: each immune subtype vs the oral and dental fractions
##    Collapse dental / oral into single labels, keep immune subtypes, run the
##    same neighborhood enrichment, then read off immune x {Oral, Dental}.
################################################################################

immune_subtypes <- c("TAM (GPNMB+/APOE+)","Macrophages","Macrophages (CCL2+)",
                     "Macrophages (CD86+)","T-cells (CD8)","T-cells (CD4/Treg)")
dental_group <- c("Transitioning","Dental Epithelium","Dental Epithelium / OEE","SI / SR",
                  "Cluster Cells","IEE","Pre-ameloblast","Ameloblast","HERS-like","Cervical Loop","PDL")
oral_group   <- c("Oral Epithelium 1","Oral Epithelium 2","Oral Epithelium 3",
                  "Junctional Keratinocytes","Junctional basal","Sulcus Keratinocytes",
                  "Sulcus basal","Oral basal","Intermediate Sulcus")

build_df_coarse <- function(roi) {
  df <- build_df(roi)
  df$coarse <- ifelse(df$label %in% immune_subtypes, df$label,
                ifelse(df$label %in% dental_group, "Dental",
                ifelse(df$label %in% oral_group, "Oral", NA)))
  df %>% filter(!is.na(coarse)) %>% mutate(label = coarse)
}

immune_df <- purrr::imap_dfr(patient_map, function(rois, pt) {
  purrr::map_dfr(rois, function(r) {
    if (!r %in% names(xenium@images)) return(NULL)
    z <- run_nhood_enrichment_squidpy(build_df_coarse(r))
    if (is.null(z)) return(NULL)
    purrr::map_dfr(intersect(immune_subtypes, rownames(z)), function(imm) {
      data.frame(immune = imm,
                 Oral   = if ("Oral"   %in% colnames(z)) z[imm,"Oral"]   else NA,
                 Dental = if ("Dental" %in% colnames(z)) z[imm,"Dental"] else NA,
                 patient = pt, roi = r)
    })
  })
})
## per-patient median, long format for plotting
immune_long <- immune_df %>%
  group_by(immune, patient) %>%
  summarise(Oral = median(Oral, na.rm = TRUE), Dental = median(Dental, na.rm = TRUE), .groups = "drop") %>%
  tidyr::pivot_longer(c(Oral, Dental), names_to = "lineage", values_to = "z")

ggplot(immune_long, aes(lineage, z, fill = lineage)) +
  geom_violin(scale = "width") + geom_jitter(width = 0.1) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  facet_wrap(~ immune, nrow = 2) +
  scale_fill_manual(values = c("Dental" = "#6BAED6", "Oral" = "#FB6A4A")) +
  theme_classic() +
  labs(y = "Neighbourhood enrichment z-score", x = NULL,
       title = "Immune subtype spatial enrichment: oral vs dental (Squidpy-equivalent)")
ggsave("plot4_immune_oral_vs_dental_violin.pdf", width = 10, height = 6)
write.csv(immune_df, "immune_oral_vs_dental_zscores.csv", row.names = FALSE)

################################################################################
## 5. Cohort-level significance (per developmental pair), BH-corrected
################################################################################

pair_pvals <- dev_df %>% filter(type == "Adjacent") %>%
  group_by(pair) %>%
  summarise(p = tryCatch(wilcox.test(z, mu = 0)$p.value, error = function(e) NA), .groups = "drop") %>%
  mutate(p_BH = p.adjust(p, method = "BH"))
write.csv(pair_pvals, "developmental_pair_pvalues_BH.csv", row.names = FALSE)
