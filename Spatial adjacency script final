## ---- 5) Helper functions ----

get_xy <- function(obj) {
  coords <- GetTissueCoordinates(obj)
  cn     <- colnames(coords)
  if (all(c("imagecol", "imagerow") %in% cn)) {
    coords <- coords[, c("imagecol", "imagerow")]
    colnames(coords) <- c("x", "y")
  } else {
    coords <- coords[, c("x", "y")]
  }
  coords
}

nn_distance <- function(df_from, df_to) {
  if (nrow(df_from) == 0L || nrow(df_to) == 0L)
    return(rep(NA_real_, max(nrow(df_from), 1L)))
  from_mat <- as.matrix(df_from[, c("x", "y")])
  to_mat   <- as.matrix(df_to[,   c("x", "y")])
  as.numeric(FNN::get.knnx(to_mat, from_mat, k = 1)$nn.dist[, 1])
}

permute_nn_test <- function(df, label_col, labs_A, labs_B,
                            n_perm = N_PERM, seed = SEED,
                            min_cells = MIN_CELLS) {
  A <- df[df[[label_col]] %in% labs_A, ]
  B <- df[df[[label_col]] %in% labs_B, ]
  if (nrow(A) < min_cells || nrow(B) < min_cells)
    return(list(n_A = nrow(A), n_B = nrow(B),
                observed = NA_real_, null_median = NA_real_,
                null_q025 = NA_real_, null_q975 = NA_real_,
                p_value = NA_real_, significant = NA, skipped = TRUE))
  obs    <- median(nn_distance(A, B), na.rm = TRUE)
  idx    <- df[[label_col]] %in% c(labs_A, labs_B)
  df_sub <- df[idx, ]
  n_cores <- max(1L, detectCores() - 1L)
  cl <- makeCluster(n_cores)
  on.exit(stopCluster(cl), add = TRUE)
  clusterExport(cl,
                varlist = c("df_sub", "label_col", "labs_A", "labs_B",
                            "nn_distance", "use_FNN"),
                envir = environment())
  clusterSetRNGStream(cl, seed)
  if (use_FNN) clusterEvalQ(cl, library(FNN))
  perm_medians <- unlist(parLapply(cl, seq_len(n_perm), function(i) {
    df_perm <- df_sub
    df_perm[[label_col]] <- sample(df_sub[[label_col]])
    A_p <- df_perm[df_perm[[label_col]] %in% labs_A, ]
    B_p <- df_perm[df_perm[[label_col]] %in% labs_B, ]
    if (nrow(A_p) == 0L || nrow(B_p) == 0L) return(NA_real_)
    median(nn_distance(A_p, B_p), na.rm = TRUE)
  }))
  p_val <- mean(perm_medians >= obs, na.rm = TRUE)
  list(n_A = nrow(A), n_B = nrow(B), observed = obs,
       null_median = median(perm_medians,          na.rm = TRUE),
       null_q025   = quantile(perm_medians, 0.025, na.rm = TRUE),
       null_q975   = quantile(perm_medians, 0.975, na.rm = TRUE),
       p_value = p_val, significant = p_val < 0.05, skipped = FALSE)
}

build_df <- function(roi_name) {
  cells  <- Cells(xenium@images[[roi_name]])
  coords <- get_xy(subset(xenium, cells = cells))
  coords$cell <- cells
  meta        <- xenium@meta.data[cells, , drop = FALSE]
  meta$cell   <- rownames(meta)
  dplyr::inner_join(meta, coords, by = "cell")
}

build_patient_df <- function(patient) {
  dplyr::bind_rows(purrr::map(patient_map[[patient]], function(rn) {
    if (!rn %in% names(xenium@images)) return(NULL)
    build_df(rn)
  }))
}

## Squidpy-equivalent neighborhood enrichment
## k=6 (Squidpy default), undirected (symmetrized), z-score = (obs-mean)/sd
run_nhood_enrichment_squidpy <- function(df, label_col,
                                          k = K_NHOOD, n_perm = N_PERM,
                                          seed = SEED) {
  set.seed(seed)
  coords     <- as.matrix(df[, c("x", "y")])
  labels     <- factor(df[[label_col]])
  cell_types <- levels(labels)
  n_types    <- length(cell_types)
  cat("    Building kNN graph (k=", k, ", n=", nrow(coords), ")...\n")
  knn_res  <- FNN::get.knn(coords, k = k)
  from_idx <- rep(seq_len(nrow(knn_res$nn.index)), each = k)
  to_idx   <- as.vector(t(knn_res$nn.index))
  from_int <- as.integer(labels)[from_idx]
  to_int   <- as.integer(labels)[to_idx]
  count_pairs_fast <- function(fi, ti) {
    m <- matrix(
      tabulate(fi + n_types * (ti - 1L), nbins = n_types * n_types),
      nrow = n_types, ncol = n_types,
      dimnames = list(cell_types, cell_types))
    m + t(m)  ## symmetrize = undirected
  }
  cat("    Computing observed counts...\n")
  obs_matrix <- count_pairs_fast(from_int, to_int)
  cat("    Running", n_perm, "permutations (parallel)...\n")
  n_cores <- max(1L, parallel::detectCores() - 1L)
  cl <- parallel::makeCluster(n_cores)
  on.exit(parallel::stopCluster(cl), add = TRUE)
  parallel::clusterExport(
    cl,
    varlist = c("labels", "from_idx", "to_idx", "from_int", "to_int",
                "cell_types", "n_types", "count_pairs_fast"),
    envir = environment())
  parallel::clusterSetRNGStream(cl, seed)
  perm_list <- parallel::parLapply(cl, seq_len(n_perm), function(i) {
    perm_int <- sample(as.integer(labels))
    count_pairs_fast(perm_int[from_idx], perm_int[to_idx])
  })
  cat("    Computing z-scores...\n")
  perm_array <- array(unlist(perm_list), dim = c(n_types, n_types, n_perm))
  perm_mean  <- apply(perm_array, c(1, 2), mean)
  perm_sd    <- apply(perm_array, c(1, 2), sd)
  perm_sd[perm_sd == 0] <- 1
  z_matrix <- (obs_matrix - perm_mean) / perm_sd
  dimnames(z_matrix) <- list(cell_types, cell_types)
  p_matrix <- matrix(NA_real_, n_types, n_types,
                     dimnames = list(cell_types, cell_types))
  for (i in seq_len(n_types))
    for (j in seq_len(n_types))
      p_matrix[i, j] <- mean(perm_array[i, j, ] >= obs_matrix[i, j])
  list(zscore = z_matrix, pvalue = p_matrix,
       observed = obs_matrix, null_mean = perm_mean)
}

## Non-linear breaks for z-score heatmap
## Makes colour transition sharper near zero
make_nonlinear_breaks <- function(z_min, z_max, n = 101, power = 0.3) {
  neg <- -((seq(0, 1, length.out = ceiling(n/2)))^(1/power)) * abs(z_min)
  pos <-  ((seq(0, 1, length.out = floor(n/2)+1))^(1/power)) * z_max
  unique(sort(c(neg, pos)))
}

## Publication theme
pub_theme <- function() {
  theme_classic(base_size = PUB_BASE) +
    theme(
      axis.text.x        = element_text(angle = 45, hjust = 1, size = PUB_AXIS),
      axis.text.y        = element_text(size = PUB_AXIS),
      axis.title         = element_text(size = PUB_TITLE),
      legend.text        = element_text(size = PUB_LEGEND),
      legend.title       = element_text(size = PUB_LEGEND),
      strip.text         = element_text(size = PUB_STRIP, face = "bold"),
      strip.background   = element_rect(fill = "grey95", colour = NA),
      panel.grid.major.y = element_line(colour = "grey92", linewidth = 0.4)
    )
}

save_plot <- function(p, name, width = 12, height = 6) {
  ggsave(file.path(out_dir, paste0(name, ".pdf")),
         p, width = width, height = height)
  ggsave(file.path(out_dir, paste0(name, ".png")),
         p, width = width, height = height, dpi = 300)
  cat("[Saved]", name, "\n")
}

save_pheatmap <- function(mat, name, colour, breaks,
                           anno, anno_col, width = 16, height = 14,
                           title = "") {
  for (ext in c("pdf", "png")) {
    fname <- file.path(out_dir, paste0(name, ".", ext))
    if (ext == "pdf") pdf(fname, width = width, height = height)
    else              png(fname, width = width, height = height,
                          units = "in", res = 300)
    pheatmap::pheatmap(
      mat,
      clustering_distance_rows = "euclidean",
      clustering_distance_cols = "euclidean",
      clustering_method        = "ward.D2",
      annotation_row           = anno,
      annotation_col           = anno,
      annotation_colors        = anno_col,
      color                    = colour,
      breaks                   = breaks,
      show_rownames             = TRUE,
      show_colnames             = TRUE,
      fontsize                  = 14,
      fontsize_row              = 13,
      fontsize_col              = 13,
      main                      = title
    )
    dev.off()
  }
  cat("[Saved]", name, "\n")
}

