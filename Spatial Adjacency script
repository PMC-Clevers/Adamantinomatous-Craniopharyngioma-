## -- Plot 5: p-value heatmap (patient × pair) --
p5 <- ggplot(
    results_df %>% dplyr::filter(!is.na(p_value)),
    aes(x = pair, y = patient, fill = p_value)
  ) +
  geom_tile(colour = "white", linewidth = 0.8) +
  geom_text(
    aes(label = ifelse(
      is.na(p_value),   "NA",
      ifelse(p_value < 0.001, "p<0.001",
      ifelse(p_value < 0.05,  sprintf("p=%.3f", p_value),
                              sprintf("%.2f",   p_value)))
    )),
    size = 3, color = "white"
  ) +
  scale_fill_gradientn(
    colours  = c("#08306B", "#2171B5", "#6BAED6", "#F7FBFF", "#FFFFFF"),
    values   = c(0, 0.01, 0.05, 0.2, 1),
    limits   = c(0, 1),
    name     = "p-value",
    na.value = "grey90"
  ) +
  theme_classic(base_size = 12) +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  xlab("") + ylab("") +
  labs(
    title    = "Spatial adjacency permutation test",
    subtitle = paste0("p-values from ", N_PERM,
                      "-iteration label permutation (", shared_subtitle, ")")
  )

ggsave(file.path(out_dir, "plot5_pvalue_heatmap.pdf"),
       p5, width = 12, height = 6)
ggsave(file.path(out_dir, "plot5_pvalue_heatmap.png"),
