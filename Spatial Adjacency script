################################################################################
#  Spatial adjacency analysis — ACP Xenium data
#  
#  Tests whether annotated cell populations along the proposed developmental
#  axis are spatially closer than expected by chance, using nearest-neighbour
#  distance analysis with 1,000-iteration label permutation testing.
#
#  Input:  Seurat object 'xenium' with:
#            - xenium@images: named FOV objects per ROI
#            - xenium@meta.data$annotation_v2: cell type annotations
#
#  Output: spatial_nn_per_ROI.csv
#          spatial_nn_per_patient.csv
#          plot1_violin_boxplot.pdf/png
#          plot2_density_overlapping.pdf/png
#          plot3_density_faceted.pdf/png
#          plot4_density_per_patient.pdf/png
#          plot5_pvalue_heatmap.pdf/png
#          plot6_observed_vs_null.pdf/png
#
#  Author: Laurens Verweij
#  Date:   2026
################################################################################

## ---- 0) Packages ----
library(Seurat)
library(dplyr)
library(ggplot2)
library(parallel)
library(tidyr)

use_FNN   <- requireNamespace("FNN", quietly = TRUE)
MIN_CELLS <- 20    # minimum cells per population to run test
N_PERM    <- 1000  # number of permutation iterations
SEED      <- 42
XLIM      <- 500   # x-axis cap for density plots (µm)

## ---- 1) Output directory ----
out_dir <- "results/spatial_adjacency"
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

## ---- 2) Patient → ROI mapping ----
## Each patient may have multiple ROIs (TMA cores)
## BT288 = ACP004 (whole-slide Xenium)
## TMA ROIs = tissue microarray cores from remaining patients
## Zoom-in ROIs excluded (ROI_BT288_2, ROI_BT288_oral_zoom*, etc.)
patient_map <- list(
  ACP004 = c("ROI_BT288_1"),
  ACP005 = c("ROI_TMA4",  "ROI_TMA9"),
  ACP006 = c("ROI_TMA1",  "ROI_TMA8",  "ROI_TMA13"),
  ACP007 = c("ROI_TMA2",  "ROI_TMA3",  "ROI_TMA6",
             "ROI_TMA7",  "ROI_TMA10", "ROI_TMA11", "ROI_TMA14"),
  ACP008 = c("ROI_TMA12")
)

## ---- 3) Annotation labels ----
annot_col  <- "annotation_v2"

labs_OE    <- c("Oral Epithelium 1", "Oral Epithelium 2", "Oral Epithelium 3")
labs_TR    <- "Transitioning"
labs_DE    <- "Dental Epithelium"
labs_DEOEE <- "Dental Epithelium / OEE"
labs_pre   <- "Pre-ameloblast"
labs_AMB   <- "Ameloblast"
labs_JK    <- "Junctional Keratinocytes"
labs_SK    <- "Sulcus Keratinocytes"
labs_SB    <- "Sulcus basal"
labs_JB    <- "Junctional basal"
labs_CCL2  <- "CCL2 inflamed keratinocytes"

## ---- 4) Population pairs to test ----
## Ordered along the proposed developmental axis:
##   Dental:  OE → TR → DE → DEOEE → pre-AMB → AMB
##   Gingival: CCL2 → JK, JB → JK, JK → AMB, SK → JK
pairs <- list(
  list(from = labs_OE,    to = labs_TR,    name = "OE → TR"),
  list(from = labs_TR,    to = labs_DE,    name = "TR → DE"),
  list(from = labs_DE,    to = labs_DEOEE, name = "DE → DEOEE"),
  list(from = labs_DEOEE, to = labs_pre,   name = "DEOEE → pre-AMB"),
  list(from = labs_pre,   to = labs_AMB,   name = "pre-AMB → AMB"),
  list(from = labs_JB,    to = labs_JK,    name = "JB → JK"),
  list(from = labs_JK,    to = labs_AMB,   name = "JK → AMB"),
  list(from = labs_SK,    to = labs_JK,    name = "SK → JK"),
  list(from = labs_CCL2,  to = labs_JK,    name = "CCL2 → JK")
)

## ---- 5) Helper functions ----

#' Extract x/y coordinates from a Seurat Xenium object
get_xy <- function(obj) {
  coords <- GetTissueCoordinates(obj)
  cn     <- colnames(coords)
  if (all(c("imagecol", "imagerow") %in% cn)) {
    coords <- coords[, c("imagecol", "imagerow")]
    colnames(coords) <- c("x", "y")
  } else if (all(c("x", "y") %in% cn)) {
    coords <- coords[, c("x", "y")]
  } else {
    stop("Unrecognised coordinate columns: ", paste(cn, collapse = ", "))
  }
  coords
}

#' Compute nearest-neighbour distance from each cell in df_from to df_to
nn_distance <- function(df_from, df_to) {
  if (nrow(df_from) == 0L || nrow(df_to) == 0L)
    return(rep(NA_real_, max(nrow(df_from), 1L)))
  from_mat <- as.matrix(df_from[, c("x", "y")])
  to_mat   <- as.matrix(df_to[,   c("x", "y")])
  if (use_FNN) {
    as.numeric(FNN::get.knnx(to_mat, from_mat, k = 1)$nn.dist[, 1])
  } else {
    ## Fallback: brute-force (slower, use for small ROIs only)
    dmat <- as.matrix(dist(rbind(from_mat, to_mat)))
    nf   <- nrow(from_mat)
    nt   <- nrow(to_mat)
    apply(dmat[seq_len(nf), nf + seq_len(nt), drop = FALSE], 1, min)
  }
}

#' Permutation test: are cells of type A significantly closer to type B
#' than expected by chance?
#' p-value = fraction of permuted null distances >= observed distance
#' (low p = observed distances are smaller than chance = significant adjacency)
permute_nn_test <- function(df, label_col, labs_A, labs_B,
                            n_perm     = N_PERM,
                            seed       = SEED,
                            min_cells  = MIN_CELLS) {
  A <- df[df[[label_col]] %in% labs_A, ]
  B <- df[df[[label_col]] %in% labs_B, ]
  
  ## Skip if either population below minimum cell threshold
  if (nrow(A) < min_cells || nrow(B) < min_cells)
    return(list(
      n_A         = nrow(A),
      n_B         = nrow(B),
      observed    = NA_real_,
      null_median = NA_real_,
      null_q025   = NA_real_,
      null_q975   = NA_real_,
      p_value     = NA_real_,
      significant = NA,
      skipped     = TRUE
    ))
  
  ## Observed median NN distance
  obs <- median(nn_distance(A, B), na.rm = TRUE)
  
  ## Permutation: shuffle labels within cells of type A or B only
  ## (preserves spatial distribution and class sizes)
  idx    <- df[[label_col]] %in% c(labs_A, labs_B)
  df_sub <- df[idx, ]
  
  ## Windows-compatible parallel permutation
  n_cores <- max(1L, detectCores() - 1L)
  cl      <- makeCluster(n_cores)
  on.exit(stopCluster(cl), add = TRUE)
  
  clusterExport(
    cl,
    varlist = c("df_sub", "label_col", "labs_A", "labs_B",
                "nn_distance", "use_FNN"),
    envir   = environment()
  )
  clusterSetRNGStream(cl, seed)
  if (use_FNN) clusterEvalQ(cl, library(FNN))
  
  perm_medians <- unlist(parLapply(cl, seq_len(n_perm), function(i) {
    df_perm              <- df_sub
    df_perm[[label_col]] <- sample(df_sub[[label_col]])
    A_p <- df_perm[df_perm[[label_col]] %in% labs_A, ]
    B_p <- df_perm[df_perm[[label_col]] %in% labs_B, ]
    if (nrow(A_p) == 0L || nrow(B_p) == 0L) return(NA_real_)
    median(nn_distance(A_p, B_p), na.rm = TRUE)
  }))
  
  ## p-value: fraction of permuted distances >= observed
  ## (significant = observed distances are smaller than null)
  p_val <- mean(perm_medians >= obs, na.rm = TRUE)
  
  list(
    n_A         = nrow(A),
    n_B         = nrow(B),
    observed    = obs,
    null_median = median(perm_medians,                    na.rm = TRUE),
    null_q025   = quantile(perm_medians, 0.025,           na.rm = TRUE),
    null_q975   = quantile(perm_medians, 0.975,           na.rm = TRUE),
    p_value     = p_val,
    significant = p_val < 0.05,
    skipped     = FALSE
  )
}

#' Build a per-cell coordinate + metadata dataframe for one ROI
build_df <- function(roi_name) {
  cells  <- Cells(xenium@images[[roi_name]])
  coords <- get_xy(subset(xenium, cells = cells))
  coords$cell <- cells
  meta        <- xenium@meta.data[cells, , drop = FALSE]
  meta$cell   <- rownames(meta)
  dplyr::inner_join(meta, coords, by = "cell")
}

## ---- 6) Main loop: permutation test per ROI × pair ----
cat("\n=== Starting spatial adjacency analysis ===\n")
cat("Patients:", paste(names(patient_map), collapse = ", "), "\n")
cat("ROIs:", sum(lengths(patient_map)), "| Pairs:", length(pairs),
    "| Permutations:", N_PERM, "\n\n")

all_results <- list()

for (patient in names(patient_map)) {
  roi_names <- patient_map[[patient]]
  cat("=== Patient:", patient, "===\n")
  
  roi_results <- list()
  
  for (rn in roi_names) {
    if (!rn %in% names(xenium@images)) {
      cat("  [SKIP]", rn, "not found in xenium@images\n")
      next
    }
    cat("  ROI:", rn, "\n")
    
    df <- build_df(rn)
    
    roi_pair_results <- lapply(pairs, function(p) {
      cat("    ·", p$name, "")
      res         <- permute_nn_test(df, annot_col, p$from, p$to)
      res$pair    <- p$name
      res$roi     <- rn
      res$patient <- patient
      if (isTRUE(res$skipped)) cat("[skipped — too few cells]\n")
      else cat(sprintf("obs=%.1f µm | null=%.1f µm | p=%.3f\n",
                       res$observed, res$null_median, res$p_value))
      as.data.frame(res)
    })
    
    roi_results[[rn]] <- dplyr::bind_rows(roi_pair_results)
  }
  
  all_results[[patient]] <- dplyr::bind_rows(roi_results)
}

results_df <- dplyr::bind_rows(all_results)

## Save immediately
write.csv(results_df,
          file.path(out_dir, "spatial_nn_per_ROI.csv"),
          row.names = FALSE)
cat("\n[Saved] spatial_nn_per_ROI.csv\n")

## ---- 7) Aggregate per patient ----
patient_summary <- results_df %>%
  dplyr::filter(!is.na(observed)) %>%
  dplyr::group_by(patient, pair) %>%
  dplyr::summarise(
    n_rois          = dplyr::n(),
    median_observed = median(observed,    na.rm = TRUE),
    median_null     = median(null_median, na.rm = TRUE),
    median_pval     = median(p_value,     na.rm = TRUE),
    n_sig_rois      = sum(significant,    na.rm = TRUE),
    .groups         = "drop"
  )

write.csv(patient_summary,
          file.path(out_dir, "spatial_nn_per_patient.csv"),
          row.names = FALSE)
cat("[Saved] spatial_nn_per_patient.csv\n")
print(patient_summary)

## ---- 8) Build raw distance dataframe for density/violin plots ----
cat("\nBuilding raw distance dataframe for plots...\n")

dist_df_full <- dplyr::bind_rows(lapply(names(patient_map), function(patient) {
  dplyr::bind_rows(lapply(patient_map[[patient]], function(rn) {
    if (!rn %in% names(xenium@images)) return(NULL)
    df <- build_df(rn)
    dplyr::bind_rows(lapply(pairs, function(p) {
      A <- df[df[[annot_col]] %in% p$from, ]
      B <- df[df[[annot_col]] %in% p$to,   ]
      if (nrow(A) < MIN_CELLS || nrow(B) < MIN_CELLS) return(NULL)
      data.frame(
        dist    = nn_distance(A, B),
        pair    = p$name,
        roi     = rn,
        patient = patient
      )
    }))
  }))
}))

